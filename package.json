{
  "name": "workshop-compilers-and-static-analysis-for-javascript-developers",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "yarn typecheck && yarn lint && yarn format:check",
    "deps:check": "depcheck --skip-missing",
    "demo:jscodeshift:oss:remove-forward-ref": "npx codemod react/19/remove-forward-ref --target src/components/demos/jscodeshift-oss.tsx",
    "demo:jscodeshift:oss:use-context-hook": "npx codemod react/19/use-context-hook --target src/components/demos/jscodeshift-oss.tsx",
    "demo:jscodeshift:custom:extract-styles": "npx jscodeshift -t src/codemods/jscodeshift-extract-inline-styles.ts --parser=tsx --extensions=tsx src/components/demos/jscodeshift-custom.tsx",
    "demo:jscodeshift:custom:extract-handlers": "npx jscodeshift -t src/codemods/jscodeshift-extract-inline-handlers.ts --parser=tsx --extensions=tsx src/components/demos/jscodeshift-custom.tsx",
    "demo:ts-morph": "npx tsx src/codemods/tsmorph-enforce-prop-interfaces.ts src/components/demos/ts-morph.tsx",
    "demo:ast-grep": "npx ast-grep scan -r src/codemods/astgrep-npx-lazy-state-initializer.yaml --update-all src/components/demos/lazy-state-initializer.tsx",
    "demo:ast-grep:derived-state": "npx ast-grep scan -r src/codemods/astgrep-npx-derived-state-effect.yaml --update-all src/components/demos/derived-state-effect.tsx",
    "demo:ast-grep-napi": "npx tsx src/codemods/astgrep-napi-lazy-state-initializer.ts src/components/demos/lazy-state-initializer.tsx",
    "demo:ast-grep-napi:derived-state": "npx tsx src/codemods/astgrep-napi-derived-state-effect.ts src/components/demos/derived-state-effect.tsx",
    "demo:ast-grep:jssg": "npx codemod jssg run --language tsx ./src/codemods/astgrep-jssg-lazy-state-initializer.ts -t src/components/demos/lazy-state-initializer.tsx --allow-dirty --no-interactive",
    "demo:ast-grep:jssg:derived-state": "npx codemod jssg run --language tsx ./src/codemods/astgrep-jssg-derived-state-effect.ts -t src/components/demos/derived-state-effect.tsx --allow-dirty --no-interactive",
    "demo:babel:find-jquery": "npx tsx scripts/babel-find-jquery.ts",
    "demo:mitosis": "npx tsx scripts/mitosis.ts",
    "demo:radius-tracker": "npx tsx scripts/radius-tracker.ts",
    "demo:radius-tracker:report": "npx radius-tracker report --database usages.sqlite.gz --outdir radius-tracker-report",
    "demo:radius-tracker:serve": "npx --yes serve radius-tracker-report",
    "demo:react-doctor": "npx react-doctor@latest src/components --verbose"
  },
  "engines": {
    "node": ">=24"
  },
  "resolutions": {
    "@babel/traverse": "7.28.5",
    "@babel/generator": "7.28.5",
    "@babel/parser": "7.28.5"
  },
  "depcheck": {
    "ignoreMatches": [
      "@components/*",
      "@utils/*",
      "codemod:*"
    ],
    "ignores": [
      "@builder.io/mitosis",
      "@ianvs/prettier-plugin-sort-imports",
      "@types/*",
      "tailwindcss"
    ],
    "ignorePatterns": [
      "dist",
      "radius-tracker-report"
    ]
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.2.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.8.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-router-dom": "7.14.0",
    "tailwind-merge": "3.5.0"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.42.1",
    "@ast-grep/napi": "0.45.1",
    "@babel/generator": "7.28.5",
    "@babel/parser": "7.28.5",
    "@babel/traverse": "7.28.5",
    "@babel/types": "7.28.5",
    "@builder.io/mitosis": "0.14.0",
    "@codemod.com/jssg-types": "1.6.3",
    "@eslint/js": "9.39.1",
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@tailwindcss/vite": "4.2.2",
    "@types/jscodeshift": "17.3.0",
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "cheerio": "^1.2.0",
    "depcheck": "1.4.7",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "jscodeshift": "17.3.0",
    "picocolors": "1.1.1",
    "prettier": "3.8.2",
    "tailwindcss": "4.2.2",
    "ts-morph": "28.0.0",
    "tsx": "4.21.0",
    "typescript": "6.0.2",
    "typescript-eslint": "8.46.4",
    "vite": "8.0.8"
  }
}
